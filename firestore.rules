// Purpose: Production-grade Cloud Firestore security rules enforcing granular authentication, trip membership verification, and expense ownership.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Check if the current user is the owner of a document (matching UID)
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Check if the user is a member or creator of a trip
    function isTripMember(tripId) {
      let tripDoc = get(/databases/$(database)/documents/trips/$(tripId));
      return isAuthenticated() && tripDoc != null && (
        tripDoc.data.createdBy == request.auth.uid ||
        (tripDoc.data.memberIds != null && request.auth.uid in tripDoc.data.memberIds)
      );
    }

    // ─── Users Collection ───────────────────────────────────────────────────
    // Authenticated users can read member profiles; only the owner can write their document.
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // ─── Trips Collection ───────────────────────────────────────────────────
    // Only trip creators or participating members can access trip data.
    match /trips/{tripId} {
      allow read: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds)
      );
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds)
      );
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // ─── Expenses Collection ─────────────────────────────────────────────────
    // Only verified members of the parent trip can create, read, or modify expenses.
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && isTripMember(resource.data.tripId);
      allow create: if isAuthenticated() && isTripMember(request.resource.data.tripId);
      allow update: if isAuthenticated() && isTripMember(resource.data.tripId);
      allow delete: if isAuthenticated() && isTripMember(resource.data.tripId);
    }

    // ─── Settlements Collection ──────────────────────────────────────────────
    // Only verified members of the parent trip can manage settlements.
    match /settlements/{settlementId} {
      allow read: if isAuthenticated() && isTripMember(resource.data.tripId);
      allow create: if isAuthenticated() && isTripMember(request.resource.data.tripId);
      allow update: if isAuthenticated() && isTripMember(resource.data.tripId);
      allow delete: if isAuthenticated() && isTripMember(resource.data.tripId);
    }

    // ─── Default Deny ───────────────────────────────────────────────────────
    // All other collections and paths are strictly blocked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
