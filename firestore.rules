// Purpose: Production-hardened Cloud Firestore Security Rules for Vazhithunai. Enforces strict UID ownership for user profiles, trip membership verification for trips, expenses, and settlements, and absolute default-deny.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────

    // Check if the request is from an authenticated Firebase Auth session
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Check if the current user is the owner of a document (matching UID)
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Check if the user is a member or creator of a trip
    function isTripMember(tripId) {
      let tripDoc = get(/databases/$(database)/documents/trips/$(tripId));
      return isAuthenticated() && tripDoc != null && (
        tripDoc.data.createdBy == request.auth.uid ||
        (tripDoc.data.memberIds != null && request.auth.uid in tripDoc.data.memberIds)
      );
    }

    // ─── Users Collection ───────────────────────────────────────────────────
    // User documents contain sensitive PII. Read and write are restricted to the owning UID only.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      allow delete: if false;
    }

    // ─── Trips Collection ───────────────────────────────────────────────────
    // Only verified trip creators and participating members can read or write trip data.
    match /trips/{tripId} {
      allow read: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.createdBy == request.auth.uid ||
        (request.resource.data.memberIds != null && request.auth.uid in request.resource.data.memberIds)
      );
      allow update: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds)
      );
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // ─── Expenses Collection ─────────────────────────────────────────────────
    // Only verified members of the parent trip can create, read, update, or delete expenses.
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && isTripMember(resource.data.tripId);
      allow create: if isAuthenticated() && isTripMember(request.resource.data.tripId);
      allow update: if isAuthenticated() && isTripMember(resource.data.tripId);
      allow delete: if isAuthenticated() && isTripMember(resource.data.tripId);
    }

    // ─── Settlements Collection ──────────────────────────────────────────────
    // Only verified members of the parent trip can read or manage settlements.
    match /settlements/{settlementId} {
      allow read: if isAuthenticated() && isTripMember(resource.data.tripId);
      allow create: if isAuthenticated() && isTripMember(request.resource.data.tripId);
      allow update: if isAuthenticated() && isTripMember(resource.data.tripId);
      allow delete: if isAuthenticated() && isTripMember(resource.data.tripId);
    }

    // ─── Default Deny ───────────────────────────────────────────────────────
    // All other collections, subcollections, and paths are strictly blocked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
